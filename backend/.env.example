# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
CLOUD_MODEL=gemini-2.5-flash

# Local model served by Ollama (https://ollama.com)
OLLAMA_URL=http://localhost:11434
LOCAL_MODEL=llama3.2:1b
# cloud | simulate | error  - what to do if no local model is available
LOCAL_UNAVAILABLE=cloud
SIMULATED_LOCAL_MODEL=gemini-2.5-flash-lite

# Router thresholds
LOCAL_MAX_INPUT_TOKENS=1500
LOW_BATTERY_PCT=20

# Impact estimates: your device's extra power draw while generating (W),
# and your grid's carbon intensity (gCO2e/kWh; world average 2025 = 458)
DEVICE_ACTIVE_WATTS=25
GRID_GCO2_PER_KWH=458
